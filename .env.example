# -----------------------------------------------------------------------------
# Sunstake - App + servicios externos
# Copia este archivo a `.env` y llena cada valor.
# -----------------------------------------------------------------------------

# Entorno de red
BASE_CHAIN_ID=84532
BASE_NETWORK=sepolia
BASE_RPC_URL=https://sepolia.base.org
BASE_RPC_FALLBACK_URL=

# Alchemy (opcional, recomendado como backup)
ALCHEMY_API_KEY=
ALCHEMY_BASE_SEPOLIA_RPC=
ALCHEMY_BASE_MAINNET_RPC=

# Basescan (explorer / verificación)
BASESCAN_API_KEY=
BASESCAN_API_URL=https://api-sepolia.basescan.org/api

# Privy (login wallet embebida)
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_CLIENT_SECRET=

# Contratos / tokens
SUNSTAKE_FACTORY_ADDRESS=
# USDC de pruebas (TestnetERC20 6 decimales) en Base Sepolia.
# Faucet con mint generoso: https://staging.aave.com/faucet (selecciona Base Sepolia).
USDC_BASE_SEPOLIA=0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f
# USDC oficial de Circle en Base Mainnet (6 decimales).
USDC_BASE_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
