# Clave privada del deployer (sin 0x prefix)
PRIVATE_KEY=

# API key de Basescan para verificación de contratos
BASESCAN_API_KEY=

# Wallet de Sunstake para recibir fees (5-8% del yield)
SUNSTAKE_TREASURY=

# RPC principal (Base Sepolia)
BASE_SEPOLIA_RPC=https://sepolia.base.org

# RPC de producción (Base Mainnet)
BASE_MAINNET_RPC=https://mainnet.base.org

# RPC alternativo (Alchemy backup - Sepolia)
ALCHEMY_BASE_SEPOLIA_RPC=

# RPC alternativo (Alchemy backup - Mainnet)
ALCHEMY_BASE_MAINNET_RPC=

# Dirección del factory desplegado (se completa después de deploy)
FACTORY_ADDRESS=
